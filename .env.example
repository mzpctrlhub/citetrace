# ==============================================================================
# CiteTrace 企业级统一多大模型配置文件 (.env)
# 说明：
#   1. 本文件已被加入 .gitignore，请放心在此填入真实 API Key，绝不会被提交到 Git。
#   2. 若暂时留空，系统会自动降级为内置离线启发式引擎（0 成本运行）。
# ==============================================================================

# ------------------------------------------------------------------------------
# [分区 1] 主力大模型配置 (commandcode_default —— 默认用于引文深度真伪核查)
# ------------------------------------------------------------------------------
COMMANDCODE_PROVIDER=openai_compatible
COMMANDCODE_API_KEY=
COMMANDCODE_BASE_URL=https://api.openai.com/v1
COMMANDCODE_MODEL=claude-sonnet-4-20250514
# 若 COMMANDCODE_PROVIDER=command_cli，可在此填写命令行模板，例如: commandcode -p {prompt}
COMMANDCODE_CLI_COMMAND=
COMMANDCODE_TIMEOUT=60

# ------------------------------------------------------------------------------
# [分区 2] 轻量快速大模型配置 (commandcode_fast —— 用于原子主张拆解、章节粗筛、快速抽取)
# 推荐免费模型: inclusionai/ling-3.1-flash:free (或 ling-3.1-flash:free)
# ------------------------------------------------------------------------------
COMMANDCODE_FAST_PROVIDER=openai_compatible
COMMANDCODE_FAST_API_KEY=
COMMANDCODE_FAST_BASE_URL=https://api.commandcode.ai/provider/v1
COMMANDCODE_FAST_MODEL=inclusionai/ling-3.1-flash:free
COMMANDCODE_FAST_TIMEOUT=60

# ------------------------------------------------------------------------------
# [分区 3] 深度推理大模型配置 (commandcode_reasoning —— 可选，用于疑难数值/逻辑复核)
# ------------------------------------------------------------------------------
COMMANDCODE_REASONING_PROVIDER=openai_compatible
COMMANDCODE_REASONING_API_KEY=
COMMANDCODE_REASONING_BASE_URL=
COMMANDCODE_REASONING_MODEL=deepseek-chat
COMMANDCODE_REASONING_TIMEOUT=90

# ------------------------------------------------------------------------------
# [分区 4] 任务角色与模型绑定 (Role Routing)
# 可选值: commandcode_default | commandcode_fast | commandcode_reasoning
# ------------------------------------------------------------------------------
ROLE_PDF_REFEREE=commandcode_fast
ROLE_SECTION_SELECTOR=commandcode_fast
ROLE_CITATION_JUDGE=commandcode_default
